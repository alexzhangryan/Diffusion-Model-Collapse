# diffusion.sub — HTCondor submit file for the EDM model-collapse experiment.
#
# Before submitting:
#   1. Build and push your Docker image:
#        docker build -t <dockerhub_username>/edm-experiment:latest .
#        docker push <dockerhub_username>/edm-experiment:latest
#   2. Bundle your code and data:
#        tar -czf experiment.tar.gz edm/ dataset/ cifar10-32x32.npz diffusion_model.py diffusion.sh
#   3. Replace <dockerhub_username> below with your Docker Hub username.
#   4. Submit: condor_submit diffusion.sub

universe                = container
container_image         = docker://genjigod/edm-experiment:latest

executable              = diffusion.sh
arguments               =

# Force unbuffered Python output so logs appear in .out file in real time
environment             = "PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1"

# Transfer input files into the job's working directory
transfer_input_files    = experiment.tar.gz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# Unpack the tarball at job start via diffusion.sh's --untar logic
# (diffusion.sh calls: python diffusion_model.py --untar experiment.tar.gz)

# Collect all output
transfer_output_files   = output/

# Resource requests
request_cpus            = 4
request_memory          = 16GB
request_disk            = 50GB
request_gpus            = 1

# GPU requirements — any CUDA-capable GPU with >= 8 GB VRAM
requirements            = (Target.CUDACapability >= 6.0) && (Target.CUDAGlobalMemoryMb >= 8192)

log                     = logs/job_$(Cluster).log
output                  = logs/job_$(Cluster)_$(Process).out
error                   = logs/job_$(Cluster)_$(Process).err

# Stream output to log files in real time instead of buffering until job ends
stream_output           = True
stream_error            = True

queue 1

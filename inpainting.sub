# inpainting.sub — HTCondor submit file for the EDM inpainting experiment.
#
# Before submitting:
#   1. Bundle code and data (run as ONE line in PowerShell):
#        tar -czf inpainting.tar.gz edm/ dataset/ cifar10-32x32.npz inpainting.py generate_inpaint.py
#   2. Copy bundle + shell script + submit file to CHTC:
#        scp inpainting.tar.gz inpainting.sh inpainting.sub apryan3@ap2001.chtc.wisc.edu:~/
#   3. On CHTC:
#        mkdir -p logs
#        condor_submit inpainting.sub

universe                = container
container_image         = docker://genjigod/edm-experiment:latest

executable              = inpainting.sh
arguments               =

environment             = "PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1"

transfer_input_files    = inpainting.tar.gz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

transfer_output_files   = output/, snapshots/

request_cpus            = 2
request_memory          = 16GB
request_disk            = 50GB
request_gpus            = 1

+WantGPULab             = true
+is_resumable           = true

requirements            = (Target.CUDACapability >= 7.5) && (Target.CUDACapability < 8.7) && (Target.CUDAGlobalMemoryMb >= 16000)

log                     = logs/inpainting_$(Cluster).log
output                  = logs/inpainting_$(Cluster)_$(Process).out
error                   = logs/inpainting_$(Cluster)_$(Process).err

stream_output           = True
stream_error            = True

queue 1
